# Use Neon -> Connection details -> Pooled connection string, sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
CAMPUSRIDE_REQUIRE_POSTGRES=1
CAMPUSRIDE_SECURE_COOKIES=1
CAMPUSRIDE_DEMO=0
CAMPUSRIDE_TIMEZONE=Asia/Kolkata
# Must exactly match https://your-project.vercel.app (no trailing slash)
CAMPUSRIDE_WEB_ORIGIN=https://your-project.vercel.app
# REMOVE the bootstrap secret from Render after first successful startup
CAMPUSRIDE_BOOTSTRAP_NAME=Your Name
CAMPUSRIDE_BOOTSTRAP_EMAIL=you@example.com
CAMPUSRIDE_BOOTSTRAP_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD_NEVER_COMMIT_IT
